---
import { Image, getImage } from "astro:assets";
import heroSlide1 from "../assets/images/hero-1.png";
import heroSlide2 from "../assets/images/hero-2.webp";
import heroSlide3 from "../assets/images/hero-3.webp";

const slides = [
  {
    src: heroSlide1,
    alt: "Niños jugando y aprendiendo en Nido Perulina",
    eager: true,
  },
  {
    src: heroSlide2,
    alt: "Niños en actividad con sus maestras en el aula",
    eager: false,
  },
  {
    src: heroSlide3,
    alt: "Maestras acompañando a los niños durante una actividad",
    eager: false,
  },
];

const heroWidths = [480, 768, 1024, 1280];
const heroSizes = "(min-width: 1024px) 50vw, calc(100vw - 2rem)";

const heroPreload = await getImage({
  src: heroSlide1,
  widths: heroWidths,
  sizes: heroSizes,
  format: "webp",
});
---

<link
  rel="preload"
  as="image"
  href={heroPreload.src}
  imagesrcset={heroPreload.srcSet.attribute}
  imagesizes={heroSizes}
  fetchpriority="high"
/>

<section
  id="hero"
  class="relative min-h-screen overflow-hidden pt-24 pb-14 lg:pt-32"
  aria-labelledby="hero-title"
>
  <h1 id="hero-title" class="sr-only">
    Nido Perulina — Educación infantil de calidad en Lima
  </h1>

  <div
    class="mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-10 px-4 lg:grid-cols-2 lg:gap-14"
  >
    <!-- Carrusel de imágenes -->
    <div
      class="relative w-full overflow-hidden rounded-2xl shadow-xl"
      role="region"
      aria-roledescription="carrusel"
      aria-label="Imágenes de Nido Perulina"
      data-carousel
    >
      <div class="relative aspect-[16/10] w-full lg:aspect-[4/3]">
        {
          slides.map((slide, i) => (
            <div
              data-slide
              class={`absolute inset-0 transition-opacity duration-700 ease-out ${
                i === 0 ? "opacity-100" : "pointer-events-none opacity-0"
              }`}
              aria-hidden={i === 0 ? "false" : "true"}
            >
              <Image
                src={slide.src}
                alt={slide.alt}
                widths={heroWidths}
                sizes={heroSizes}
                format="webp"
                loading={slide.eager ? "eager" : "lazy"}
                decoding={slide.eager ? "auto" : "async"}
                fetchpriority={slide.eager ? "high" : "auto"}
                class="h-full w-full object-cover"
              />
            </div>
          ))
        }

        <!-- Degradado inferior para legibilidad de los controles -->
        <div
          class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/40 to-transparent"
          aria-hidden="true"
        >
        </div>

        <button
          type="button"
          data-carousel-prev
          class="absolute left-3 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/80 text-primary shadow-md transition hover:bg-white"
          aria-label="Imagen anterior"
        >
          <svg
            aria-hidden="true"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>
        <button
          type="button"
          data-carousel-next
          class="absolute right-3 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/80 text-primary shadow-md transition hover:bg-white"
          aria-label="Imagen siguiente"
        >
          <svg
            aria-hidden="true"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </button>

        <div
          class="absolute bottom-3 left-1/2 z-10 flex -translate-x-1/2 gap-2"
        >
          {
            slides.map((_, i) => (
              <button
                type="button"
                data-carousel-dot={i}
                aria-label={`Ir a la imagen ${i + 1}`}
                aria-current={i === 0 ? "true" : "false"}
                class={`h-2.5 w-2.5 rounded-full transition ${
                  i === 0 ? "bg-white" : "bg-white/50"
                }`}
              />
            ))
          }
        </div>
      </div>
    </div>

    <!-- Formulario de inscripción -->
    <div class="flex items-center justify-center">
      <div class="w-full max-w-md">
        <form
          id="form-inscripcion"
          method="post"
          action="#"
          class="space-y-3 rounded-2xl border border-gray-200 bg-white p-6 shadow-xl"
          novalidate
        >
          <h2
            class="mb-4 text-center text-2xl font-bold text-primary"
            id="form-inscripcion-title"
          >
            Agenda tu cita
          </h2>

          <!-- Nombres -->
          <div>
            <label
              for="nombres"
              class="mb-2 block text-sm font-medium text-primary"
            >
              Nombres del Padre/Madre <span class="text-red-400">*</span>
            </label>
            <input
              type="text"
              id="nombres"
              name="nombres"
              placeholder="Nombres"
              autocomplete="name"
              class="input input-bordered w-full"
              aria-required="true"
              aria-describedby="nombres-error"
              required
              minlength="3"
            />
            <div
              id="nombres-error"
              class="error-message mt-1 hidden text-sm text-red-400"
              role="alert"
            >
              Ingrese los nombres del padre/madre
            </div>
          </div>

          <!-- Edad -->
          <div>
            <label for="edad" class="mb-2 block text-sm font-medium text-primary">
              Edad del niño/a <span class="text-red-400">*</span>
            </label>
            <input
              type="number"
              id="edad"
              name="edad"
              placeholder="Edad"
              class="input input-bordered w-full"
              inputmode="numeric"
              aria-required="true"
              aria-describedby="edad-error"
              required
              min="1"
              max="18"
            />
            <div
              id="edad-error"
              class="error-message mt-1 hidden text-sm text-red-400"
              role="alert"
            >
              Ingrese la edad
            </div>
          </div>

          <!-- Día -->
          <div>
            <label for="dia" class="mb-2 block text-sm font-medium text-primary">
              Día <span class="text-red-400">*</span>
            </label>
            <input
              type="date"
              id="dia"
              name="dia"
              class="input input-bordered w-full"
              aria-required="true"
              aria-describedby="dia-error"
              required
            />
            <div
              id="dia-error"
              class="error-message mt-1 hidden text-sm text-red-400"
              role="alert"
            >
              Seleccione un día
            </div>
          </div>

          <!-- Hora -->
          <div>
            <label for="hora" class="mb-2 block text-sm font-medium text-primary">
              Hora <span class="text-red-400">*</span>
            </label>
            <input
              type="time"
              id="hora"
              name="hora"
              class="input input-bordered w-full"
              aria-required="true"
              aria-describedby="hora-error"
              required
            />
            <div
              id="hora-error"
              class="error-message mt-1 hidden text-sm text-red-400"
              role="alert"
            >
              Seleccione una hora
            </div>
          </div>

          <button
            type="submit"
            id="submit-inscripcion-btn"
            class="btn btn-secondary btn-lg w-full"
          >
            Agendar por WhatsApp
          </button>

          <p
            id="form-inscripcion-feedback"
            class="hidden rounded-lg px-4 py-3 text-center text-white"
            aria-live="polite"
          >
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  input[type="number"]::-webkit-inner-spin-button,
  input[type="number"]::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  input[type="number"] {
    -moz-appearance: textfield;
    appearance: textfield;
  }
</style>

<script>
  import { openWhatsApp, setFormFeedback } from "../scripts/whatsapp";

  function initCarousel(root: HTMLElement) {
    if (root.dataset.carouselReady === "true") return;
    root.dataset.carouselReady = "true";

    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
    const dots = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]"),
    );
    if (slides.length < 2) return;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    let index = 0;
    let timer: number | undefined;

    const goTo = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle("opacity-100", active);
        slide.classList.toggle("opacity-0", !active);
        slide.classList.toggle("pointer-events-none", !active);
        slide.setAttribute("aria-hidden", String(!active));
      });
      dots.forEach((dot, i) => {
        const active = i === index;
        dot.setAttribute("aria-current", String(active));
        dot.classList.toggle("bg-white", active);
        dot.classList.toggle("bg-white/50", !active);
      });
    };

    const stop = () => {
      if (timer) {
        window.clearInterval(timer);
        timer = undefined;
      }
    };

    const start = () => {
      if (reduceMotion) return;
      stop();
      timer = window.setInterval(() => goTo(index + 1), 5000);
    };

    root
      .querySelector("[data-carousel-prev]")
      ?.addEventListener("click", () => {
        goTo(index - 1);
        start();
      });
    root
      .querySelector("[data-carousel-next]")
      ?.addEventListener("click", () => {
        goTo(index + 1);
        start();
      });
    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        goTo(i);
        start();
      }),
    );

    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);
    root.addEventListener("focusin", stop);
    root.addEventListener("focusout", start);
    root.addEventListener("keydown", (event) => {
      const key = (event as KeyboardEvent).key;
      if (key === "ArrowLeft") {
        goTo(index - 1);
        start();
      }
      if (key === "ArrowRight") {
        goTo(index + 1);
        start();
      }
    });

    goTo(0);
    start();
  }

  function initHeroForm() {
    const form = document.getElementById("form-inscripcion") as HTMLFormElement | null;
    const submitBtn = document.getElementById(
      "submit-inscripcion-btn",
    ) as HTMLButtonElement | null;
    const feedback = document.getElementById(
      "form-inscripcion-feedback",
    ) as HTMLParagraphElement | null;

    if (!form || !submitBtn || !feedback) return;
    if (form.dataset.whatsappReady === "true") return;
    form.dataset.whatsappReady = "true";

    const showFieldError = (input: HTMLInputElement, show: boolean) => {
      const error = document.getElementById(`${input.id}-error`);
      input.classList.toggle("input-error", show);
      input.setAttribute("aria-invalid", String(show));
      error?.classList.toggle("hidden", !show);
    };

    const validateField = (input: HTMLInputElement): boolean => {
      const value = input.value.trim();
      let valid = true;

      if (input.required && !value) valid = false;
      if (valid && input.minLength > 0 && value.length < input.minLength)
        valid = false;
      if (valid && input.type === "number") {
        const number = Number(value);
        const min = input.min ? Number(input.min) : -Infinity;
        const max = input.max ? Number(input.max) : Infinity;
        if (Number.isNaN(number) || number < min || number > max) valid = false;
      }
      if (valid && input.type === "date" && Number.isNaN(Date.parse(value)))
        valid = false;
      if (valid && input.type === "time" && !/^\d{2}:\d{2}$/.test(value))
        valid = false;

      showFieldError(input, !valid);
      return valid;
    };

    const inputs = Array.from(form.querySelectorAll<HTMLInputElement>("input"));
    inputs.forEach((input) => {
      input.addEventListener("input", () => {
        if (input.getAttribute("aria-invalid") === "true") validateField(input);
      });
      input.addEventListener("blur", () => validateField(input));
    });

    const setFeedback = (message: string, success: boolean) =>
      setFormFeedback(feedback, message, success);

    form.addEventListener("submit", (event: SubmitEvent) => {
      event.preventDefault();

      const isValid = inputs.map((input) => validateField(input)).every(Boolean);
      if (!isValid) {
        inputs.find((input) => input.getAttribute("aria-invalid") === "true")?.focus();
        setFeedback("Revise los campos marcados e intente de nuevo.", false);
        return;
      }

      const data = new FormData(form);
      openWhatsApp([
        "*Nido Perulina - Agenda tu cita*",
        `Padre/Madre: ${data.get("nombres")}`,
        `Edad del niño/a: ${data.get("edad")}`,
        `Día: ${data.get("dia")}`,
        `Hora: ${data.get("hora")}`,
      ]);

      form.reset();
      inputs.forEach((input) => showFieldError(input, false));
      setFeedback("Abrimos WhatsApp con su solicitud. Si no se abre, escríbanos al 922 935 447.", true);
    });
  }

  function initHero() {
    document
      .querySelectorAll<HTMLElement>("[data-carousel]")
      .forEach(initCarousel);
    initHeroForm();
  }

  document.addEventListener("astro:page-load", initHero);
</script>
