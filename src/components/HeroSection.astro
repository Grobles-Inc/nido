---
---

<section class="relative min-h-screen  text-white md:bg-rose-100">

</section>

<div
class=" absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 mx-auto w-full lg:pt-16 pb-8 "
>
<div class="success-message" id="success-message" style="display:none; background-color: #34d399; color: white; padding: 1rem; border-radius: 0.5rem; margin-top: 1rem;">
  ¡Cita agendada con éxito!
</div>
<div class="error-alert" id="error-alert" style="display:none; background-color: #f87171; color: white; padding: 1rem; border-radius: 0.5rem; margin-top: 1rem;">
  Hubo un error al enviar el formulario. Por favor, inténtalo de nuevo.
</div>
<!-- Grid adaptativo: vertical en móvil, horizontal en desktop -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8  items-center ">
  
 
    <!-- Segunda columna: Formulario de inscripción -->
    <div class="flex items-center justify-center ">
      <div class="w-full max-w-md ">
        <form
          id="form-inscripcion"
          method="post"
          action="#"
          class="space-y-3 bg-white p-6 rounded-2xl shadow-xl border border-gray-200"
        >
          <h2 class="font-bold text-primary mb-4 text-center text-2xl">
            Agenda tu cita
          </h2>

          <!-- Nombres -->
          <div>
            <label
              for="nombres"
              class="block text-sm font-medium text-primary mb-2"
            >
              Nombres del Padre/Madre <span class="text-red-400">*</span>
            </label>
            <input
              type="text"
              id="nombres"
              name="nombres"
              placeholder="Nombres"
              class="input input-bordered w-full"
              required
              minlength="3"
            />
            <div
              id="nombres-error"
              class="error-message text-red-400 text-sm mt-1 hidden"
            >
             Nombres del Padre/Madre
            </div>
          </div>

          <!-- Edad -->
          <div>
            <label
              for="edad"
              class="block text-sm font-medium text-primary mb-2"
            >
              Edad del niño/a <span class="text-red-400">*</span>
            </label>
            <input
              type="number"
              id="edad"
              name="edad"
              placeholder="Edad"
              class="input input-bordered w-full"
              required
              min="1"
              max="18"
              inputmode="numeric"
              style="appearance: textfield; -moz-appearance: textfield;"
              onwheel="this.blur()"
            />
            <style>
              /* Hide increment/decrement arrows in number inputs for all browsers */
              input[type=number]::-webkit-inner-spin-button, 
              input[type=number]::-webkit-outer-spin-button { 
                -webkit-appearance: none;
                margin: 0;
              }
              input[type=number] {
                -moz-appearance: textfield;
              }
            </style>
            <div
              id="edad-error"
              class="error-message text-red-400 text-sm mt-1 hidden"
            >
              Ingrese la edad
            </div>
          </div>

          <!-- Día -->
          <div>
            <label
              for="dia"
              class="block text-sm font-medium text-primary mb-2"
            >
              Día <span class="text-red-400">*</span>
            </label>
            <input
              type="date"
              id="dia"
              name="dia"
              placeholder="Día"
              class="input input-bordered w-full"
              required
            />
            <div
              id="dia-error"
              class="error-message text-red-400 text-sm mt-1 hidden"
            >
              Seleccione un día
            </div>
          </div>

          <!-- Hora -->
          <div>
            <label
              for="hora"
                  class="block text-sm font-medium text-primary mb-2"
            >
              Hora <span class="text-red-400">*</span>
            </label>
            <input
              type="time"
              id="hora"
              name="hora"
              placeholder="Hora"
              class="input input-bordered w-full"
              required
            />
            <div
              id="hora-error"
              class="error-message text-red-400 text-sm mt-1 hidden"
            >
              Seleccione una hora
            </div>
          </div>

          <button
            type="submit"
            id="submit-inscripcion-btn"
            class="btn btn-secondary btn-lg w-full"
          >
           Agendar
          </button>
        </form>
      </div>
    </div>
  
    <div class="hidden md:block">
      <img src="https://i.ibb.co/WvzVnhqq/Dise-os-Perulina-2.png" alt="Niños jugando" class="w-full h-full object-cover object-center rounded-l-xl" />
    </div>
    
  </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // 🚨 REEMPLAZA ESTA URL CON LA URL DE TU APPSCRIPT DEPLOYED 🚨
    const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbx3SaSVcNyGgvoNsWGEzYP9ikzvm-UsZW1BpbhN1JNsG3zjzNk9FpVqhvGmHdM8vDUZ/exec"; 
    
    const form = document.getElementById("form-inscripcion") as HTMLFormElement;
    const submitBtn = document.getElementById(
      "submit-inscripcion-btn",
    ) as HTMLButtonElement;

    // Elementos para el feedback (añádelos a tu HTML si no existen)
    // <div id="success-message" class="success-message">Cita agendada con éxito.</div>
    // <div id="error-alert" class="error-alert">Hubo un error al agendar la cita.</div>
    const successMessage = document.getElementById("success-message") as HTMLDivElement;
    const errorAlert = document.getElementById("error-alert") as HTMLDivElement;

    if (!form || !submitBtn) {
      console.error("Required DOM elements not found");
      return;
    }

    // --- Lógica de validación (Mantenemos tu lógica) ---

    const showError = (inputId: string, show: boolean): void => {
      const input = document.getElementById(inputId) as HTMLInputElement;
      const errorElement = document.getElementById(
        `${inputId}-error`,
      ) as HTMLDivElement;

      if (!input || !errorElement) {
        return;
      }

      if (show) {
        input.classList.add("input-error");
        errorElement.classList.remove("hidden");
      } else {
        input.classList.remove("input-error");
        errorElement.classList.add("hidden");
      }
    };

    const validateField = (input: HTMLInputElement): boolean => {
      // Tu lógica de validación
      if (input.required && !input.value) {
        showError(input.id, true);
        return false;
      }
      if ("minLength" in input && input.value.length < input.minLength) {
        showError(input.id, true);
        return false;
      }
      showError(input.id, false);
      return true;
    };

    const inputs = form.querySelectorAll<HTMLInputElement>("input");
    inputs.forEach((input) => {
      input.addEventListener("input", () => validateField(input));
      input.addEventListener("blur", () => validateField(input));
    });

    // --- Lógica de Envío a Apps Script ---

    form.addEventListener("submit", async (e: SubmitEvent) => {
      e.preventDefault();

      let isValid = true;
      inputs.forEach((input) => {
        if (!validateField(input)) {
          isValid = false;
        }
      });

      if (!isValid) {
        return;
      }
      
      // Deshabilitar botón
      submitBtn.disabled = true;
      submitBtn.innerHTML = "Agendando...";

      try {
        const formData = new FormData(form);
        
        // ENVÍO DE DATOS
        const response = await fetch(SCRIPT_URL, {
          method: "POST",
          body: formData, // Envía como FormData para Apps Script
        });

        if (response.ok) {
          form.reset();
          if (successMessage) successMessage.style.display = "block";
          if (errorAlert) errorAlert.style.display = "none";
          setTimeout(() => {
            if (successMessage) successMessage.style.display = "none";
          }, 5000);
        } else {
          // Leer la respuesta si falla el Apps Script
          const errorText = await response.text();
          throw new Error(`Error en el servidor: ${response.status}. Detalle: ${errorText}`);
        }
      } catch (error) {
        console.error("Error:", error);
        if (errorAlert) errorAlert.style.display = "block";
        if (successMessage) successMessage.style.display = "none";
        setTimeout(() => {
          if (errorAlert) errorAlert.style.display = "none";
        }, 5000);
      } finally {
        // Re-habilitar botón
        submitBtn.disabled = false;
        submitBtn.innerHTML = "Agendar";
      }
    });
  });
</script>
