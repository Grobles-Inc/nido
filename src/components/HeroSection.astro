---
import { Image } from "astro:assets";
import heroImage from "../../public/images/hero.png";
---

<section class="relative min-h-screen bg-gray-800 text-white">
  <!-- Background Image con overlay -->
  <div class="absolute inset-0 z-0">
    <Image
      src={heroImage}
      alt="Background image of a classroom with children"
      quality="mid"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      class="w-full h-full object-cover object-bottom"
    />
  </div>
  <div class="absolute inset-0 bg-black opacity-50"></div>
</section>

<div
  class="max-w-7xl absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 mx-auto w-full lg:pt-16 pb-8"
>
  <!-- Grid adaptativo: vertical en móvil, horizontal en desktop -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
    <div></div>
    <!-- Segunda columna: Formulario de inscripción -->
    <div class="flex items-center justify-center mt-8 lg:mt-20">
      <div class="w-full max-w-md">
        <form
          id="form-inscripcion"
          method="post"
          action="#"
          class="space-y-3 sm:space-y-4 bg-black/20 backdrop-blur-sm p-4 sm:p-6 rounded-2xl border border-white/20 shadow-lg"
        >
          <h2 class="font-bold text-white text-center text-2xl">
            Agenda tu cita
          </h2>

          <!-- Nombres -->
          <div>
            <label
              for="nombres"
              class="block text-sm font-medium text-white mb-2"
            >
              Tus Nombres <span class="text-red-400">*</span>
            </label>
            <input
              type="text"
              id="nombres"
              name="nombres"
              placeholder="Nombres"
              class="input input-bordered w-full"
              required
              minlength="3"
            />
            <div
              id="nombres-error"
              class="error-message text-red-400 text-sm mt-1 hidden"
            >
              Ingrese sus nombres
            </div>
          </div>

          <!-- Niño -->
          <div>
            <label
              for="niño"
              class="block text-sm font-medium text-white mb-2"
            >
              Nombre del Niño/a <span class="text-red-400">*</span>
            </label>
            <input
              type="text"
              id="niño"
              name="niño"
              placeholder="Nombre del Niño/a"
              class="input input-bordered w-full"
              required
              minlength="2"
            />
            <div
              id="niño-error"
              class="error-message text-red-400 text-sm mt-1 hidden"
            >
              Ingrese el nombre del niño
            </div>
          </div>

          <!-- Día -->
          <div>
            <label
              for="dia"
              class="block text-sm font-medium text-white mb-2"
            >
              Día <span class="text-red-400">*</span>
            </label>
            <input
              type="date"
              id="dia"
              name="dia"
              placeholder="Día"
              class="input input-bordered w-full"
              required
            />
            <div
              id="dia-error"
              class="error-message text-red-400 text-sm mt-1 hidden"
            >
              Seleccione un día
            </div>
          </div>

          <!-- Hora -->
          <div>
            <label
              for="hora"
              class="block text-sm font-medium text-white mb-2"
            >
              Hora <span class="text-red-400">*</span>
            </label>
            <input
              type="time"
              id="hora"
              name="hora"
              placeholder="Hora"
              class="input input-bordered w-full"
              required
            />
            <div
              id="hora-error"
              class="error-message text-red-400 text-sm mt-1 hidden"
            >
              Seleccione una hora
            </div>
          </div>

          <button
            type="submit"
            id="submit-inscripcion-btn"
            class="w-full bg-secondary hover:bg-transparent border-2 border-secondary hover:text-secondary text-white font-bold py-2 sm:py-3 px-4 sm:px-6 rounded-full transition-colors duration-300 text-sm sm:text-base cursor-pointer"
          >
            Enviar
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("form-inscripcion") as HTMLFormElement;
    const submitBtn = document.getElementById(
      "submit-inscripcion-btn",
    ) as HTMLButtonElement;

    if (!form || !submitBtn) {
      console.error("Required DOM elements not found");
      return;
    }

    const showError = (inputId: string, show: boolean): void => {
      const input = document.getElementById(inputId) as HTMLInputElement;
      const errorElement = document.getElementById(
        `${inputId}-error`,
      ) as HTMLDivElement;

      if (!input || !errorElement) {
        return;
      }

      if (show) {
        input.classList.add("input-error");
        errorElement.classList.remove("hidden");
      } else {
        input.classList.remove("input-error");
        errorElement.classList.add("hidden");
      }
    };

    const validateField = (input: HTMLInputElement): boolean => {
      if (input.required && !input.value) {
        showError(input.id, true);
        return false;
      }

      if ("minLength" in input && input.value.length < input.minLength) {
        showError(input.id, true);
        return false;
      }

      showError(input.id, false);
      return true;
    };

    const inputs = form.querySelectorAll<HTMLInputElement>("input");
    inputs.forEach((input) => {
      input.addEventListener("input", () => validateField(input));
      input.addEventListener("blur", () => validateField(input));
    });

    form.addEventListener("submit", (e: SubmitEvent) => {
      e.preventDefault();

      let isValid = true;
      inputs.forEach((input) => {
        if (!validateField(input)) {
          isValid = false;
        }
      });

      if (!isValid) {
        return;
      }

      const formData = new FormData(form);
      const nombres = formData.get("nombres") as string;
      const niño = formData.get("niño") as string;
      const dia = formData.get("dia") as string;
      const hora = formData.get("hora") as string;

      // Format date as dd/mm/yyyy
      const dateObj = new Date(dia);
      const day = String(dateObj.getDate()).padStart(2, "0");
      const month = String(dateObj.getMonth() + 1).padStart(2, "0");
      const year = dateObj.getFullYear();
      const formattedDate = `${day}/${month}/${year}`;

      // Format time
      const [hours, minutes] = hora.split(":");
      const formattedTime = `${hours}:${minutes}`;

      // Build message
      const message = `Hola, quiero agendar una cita, estos son los detalles :

Nombres: ${nombres}
Niño: ${niño}
Día: ${formattedDate}
Hora: ${formattedTime}`;

      // WhatsApp number (51922935447)
      const whatsappNumber = "51922935447";
      const encodedMessage = encodeURIComponent(message);
      const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodedMessage}`;

      // Open WhatsApp
      window.open(whatsappUrl, "_blank");
      
      // Reset form
      form.reset();
    });
  });
</script>
