---
import { ClientRouter } from "astro:transitions";
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import "aos/dist/aos.css";
import { SITE_TITLE, SITE_URL, SITE_AUTHOR, SITE_KEYWORDS } from "../consts";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "article" | "website";
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = "/og.png", type = "website" } = Astro.props;

// Schema.org
const structuredData = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  name: SITE_TITLE,
  description: description,
  url: SITE_URL,
  logo: new URL("/favicon.png", Astro.site),
  sameAs: [
    "https://www.facebook.com/NidoPerulina",
    "https://www.instagram.com/nidoperulina",
  ],
  educationalCredentialAwarded: "Educación Infantil",
  address: {
    "@type": "PostalAddress",
    addressCountry: "PE",
    addressLocality: "Lima",
    addressRegion: "Lima",
    postalCode: "15001",
    streetAddress: "Av. Agustín de la Rosa Toro 908",
  },
  telephone: "+51 922 935 447",
  email: "info@nidoperulina.com",
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#ffffff" />
<meta name="color-scheme" content="light" />
<link rel="icon" type="image/svg+xml" href="/favicon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="author" content={SITE_AUTHOR} />
<meta name="keywords" content={SITE_KEYWORDS} />

<!-- View Transitions (una sola vez, en todo el sitio) -->
<ClientRouter />

<!-- Font preloads -->
<link
  rel="preload"
  href="/fonts/DarkerGrotesque-ExtraBold.ttf"
  as="font"
  type="font/ttf"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/Neulis_Neue_Regular.otf"
  as="font"
  type="font/otf"
  crossorigin
/>

<!-- Resource hints -->
<link rel="dns-prefetch" href="//js-na1.hs-scripts.com" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<meta property="og:site_name" content={SITE_TITLE} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- Schema.org -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

<!-- AOS: se carga de forma lazy, fuera del critical path de renderizado -->
<script>
  let aosLoaded = false;
  const prefersReducedMotion = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Con movimiento reducido eliminamos data-aos para que el contenido
  // nunca quede oculto (aos.css aplica opacity:0 a esos elementos).
  function disableAOS() {
    document
      .querySelectorAll("[data-aos]")
      .forEach((element) => element.removeAttribute("data-aos"));
  }

  function loadAOS() {
    if (aosLoaded) return;
    aosLoaded = true;

    if (prefersReducedMotion()) {
      disableAOS();
      return;
    }

    import("aos").then(({ default: AOS }) => {
      AOS.init({
        duration: 500,
        once: true,
        offset: 100,
        easing: "ease-in-out",
      });
      (window as unknown as { AOS: typeof AOS }).AOS = AOS;
    });
  }

  // Se carga en el primer momento libre tras el primer pintado
  if ("requestIdleCallback" in window) {
    window.requestIdleCallback(() => loadAOS(), { timeout: 1500 });
  } else {
    window.setTimeout(loadAOS, 800);
  }

  // Refresco tras navegaciones con ClientRouter
  document.addEventListener("astro:page-load", () => {
    if (prefersReducedMotion()) {
      disableAOS();
      return;
    }
    if (aosLoaded) {
      (window as unknown as { AOS?: { refresh: () => void } }).AOS?.refresh();
    } else {
      loadAOS();
    }
  });
</script>
