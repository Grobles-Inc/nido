---
import { SITE_TITLE } from "../../consts";
import { getCollection } from "astro:content";
import BlogCard from "../../components/BlogCard.astro";
import { BLOG_CATEGORIES } from "../../content.config";
import Page from "../../layouts/Page.astro";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Page
	title={`Blog - ${SITE_TITLE}`}
	description="Artículos educativos sobre el desarrollo infantil, actividades preescolares y consejos para padres."
>
	<main class="container mx-auto pt-12 md:pt-8 md:py-8 lg:py-12">
		<div class="max-w-6xl mx-auto">
			<header class="text-center mb-12 px-4" role="banner">
				<div class="flex items-center justify-center gap-2 mb-4 pt-24">
					<h1 class="text-4xl lg:text-8xl font-bold text-primary">
						Nuestro Blog
					</h1>
					<span
						class="text-3xl hidden lg:block"
						role="img"
						aria-label="Decoración brillante">✨</span
					>
				</div>
				<p class="text-base-content/80 max-w-2xl mx-auto">
					Variedad de temas diseñados para apoyar el crecimiento de tu hijo,
					actividades de aprendizaje divertidas, consejos de salud y más.
				</p>
			</header>

			<nav
				class="flex flex-col md:justify-center md:flex-row gap-6 mb-8 pb-2 px-4"
				aria-label="Filtrar por categoría"
			>
				<div class="flex flex-wrap gap-2 md:min-w-max">
					<a
						href="/blog"
						data-category-filter=""
						class="btn btn-lg btn-outline rounded-full"
					>
						Todos
					</a>
					{
						BLOG_CATEGORIES.map((cat: string) => (
							<a
								href={`/blog?category=${encodeURIComponent(cat)}`}
								data-category-filter={cat}
								class={`btn btn-lg btn-outline rounded-full ${cat}`}
							>
								{cat.charAt(0).toUpperCase() + cat.slice(1)}
							</a>
						))
					}
				</div>
				<div class="flex items-center gap-2 justify-center">
					<label class="sr-only" for="blog-search">
					Buscar artículos
					</label>
					<input
						type="search"
						id="blog-search"
						placeholder="Buscar"
						class="input input-lg rounded-full"
						autocomplete="off"
					/>
					<button
						type="button"
						class="btn btn-lg btn-secondary btn-circle"
						aria-label="Buscar artículos"
						tabindex="-1"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							fill="none"
							viewBox="0 0 24 24"
							stroke-width="2.5"
							stroke="currentColor"
							class="size-[1.2em]"
							><path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"
							></path></svg
						>
					</button>
				</div>
			</nav>

			<p
				id="blog-empty"
				class="hidden text-center text-lg py-12"
				role="status"
				aria-live="polite"
			>
				No encontramos artículos con esa búsqueda.
			</p>

			<section
				class="grid grid-cols-1 md:grid-cols-2 px-4 lg:grid-cols-3 gap-6"
				aria-label="Lista de artículos del blog"
				id="blog-list"
			>
				{
					posts.map((post, index) => (
						<article
							data-post
							data-category={post.data.category}
							data-title={`${post.data.title} ${post.data.description}`.toLowerCase()}
						>
							<BlogCard
								key={index}
								title={post.data.title}
								category={post.data.category}
								date={post.data.pubDate}
								href={`/blog/${post.id}/`}
								image={post.data.heroImage || ""}
							/>
						</article>
					))
				}
			</section>
		</div>
	</main>
</Page>

<script>
	// Filtrado en cliente (categoría + búsqueda) para mantener /blog estático
	function applyBlogFilters() {
		const list = document.getElementById("blog-list");
		const empty = document.getElementById("blog-empty");
		const search = document.getElementById(
			"blog-search",
		) as HTMLInputElement | null;
		if (!list) return;

		const params = new URLSearchParams(window.location.search);
		const category = params.get("category") ?? "";
		const query = (search?.value ?? "").trim().toLowerCase();

		let visible = 0;
		list.querySelectorAll<HTMLElement>("[data-post]").forEach((post) => {
			const matchCategory = !category || post.dataset.category === category;
			const matchQuery = !query || (post.dataset.title ?? "").includes(query);
			const show = matchCategory && matchQuery;
			post.classList.toggle("hidden", !show);
			if (show) visible += 1;
		});

		empty?.classList.toggle("hidden", visible > 0);

		document
			.querySelectorAll<HTMLAnchorElement>("[data-category-filter]")
			.forEach((link) => {
				const isActive = (link.dataset.categoryFilter ?? "") === category;
				link.classList.toggle("btn-primary", isActive);
				link.classList.toggle("btn-outline", !isActive);
				if (isActive) link.setAttribute("aria-current", "page");
				else link.removeAttribute("aria-current");
			});
	}

	document.addEventListener("astro:page-load", applyBlogFilters);
	document.addEventListener("DOMContentLoaded", applyBlogFilters);

	document.addEventListener("input", (event) => {
		if ((event.target as HTMLElement)?.id === "blog-search") {
			applyBlogFilters();
		}
	});
</script>
