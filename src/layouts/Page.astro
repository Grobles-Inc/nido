---
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import CTASection from "../components/CTASection.astro";
import { WHATSAPP_NUMBER } from "../consts";

const { title, description, heroImage } = Astro.props;
const ogImage = heroImage
	? new URL(heroImage, Astro.url)
	: new URL("/og.png", Astro.url);
---

<!doctype html>
<html lang="es" data-theme="nido">
	<head>
		<meta charset="UTF-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.png" />
		<BaseHead title={title} description={description}>
			<meta property="og:type" content="website" />
			<meta property="og:title" content={title} />
			<meta property="og:description" content={description} />
			<meta property="og:url" content={Astro.url} />
			<meta property="og:image" content={ogImage} />

			<meta name="twitter:card" content="summary_large_image" />
			<link rel="canonical" href={Astro.url} />
		</BaseHead>
	</head>

	<body class="min-h-screen bg-base-100">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-white"
		>
			Saltar al contenido principal
		</a>
		<Header />
		<main id="main-content">
			{
				heroImage && (
					<figure class="relative w-full md:h-[600px] h-[400px] mb-16  overflow-hidden  ">
						<Image
							src={heroImage}
							alt={`Imagen principal para la página: ${title}`}
							class="w-full h-full object-cover"
							width={1024}
							height={768}
							loading="eager"
							fetchpriority="high"
						/>
						<div class="absolute z-10 top-1/2 left-1/2 space-y-4 -translate-x-1/2 -translate-y-1/2 text-center w-full md:w-1/2 px-4">
							<h1
								class="text-4xl text-white md:text-8xl font-bold"
								data-aos="fade-up"
								data-aos-delay="200"
							>
								{title}
							</h1>
							<p
								class="text-white  md:text-xl "
								data-aos="fade-up"
								data-aos-delay="400"
							>
								{description}
							</p>
						</div>
						<div
							class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"
							aria-hidden="true"
						/>
					</figure>
				)
			}

			<slot />
			<CTASection />
		</main>
		<Footer />
		<script>
			// HubSpot se carga de forma lazy (interacción del usuario o 3s) para reducir el TBT
			import "../scripts/hubspot-loader.js";
		</script>

		<!-- WhatsApp Floating Button -->
		<a
			href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent("Hola, Nido Perulina. Quisiera más información.")}`}
			target="_blank"
			rel="noopener noreferrer"
			class="fixed bottom-6 right-4 z-50 rounded-full drop-shadow-lg transition-transform duration-200 hover:scale-105"
			aria-label="Contactar por WhatsApp"
		>
			<!-- WhatsApp icon -->
			<img
				src="https://img.icons8.com/?size=200&id=AltfLkFSP7XN&format=png&color=000000"
				alt=""
				aria-hidden="true"
				class="size-14 md:size-16"
				width="64"
				height="64"
				loading="lazy"
			/>
		</a>
	</body>
</html>
